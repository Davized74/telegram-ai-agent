# Database
DATABASE_URL=sqlite+aiosqlite:///./agenda.db

# Telegram Bot (opzionale - se vuoi usare bot Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# AI Provider (OpenRouter / Groq)
AI_PROVIDER=openrouter
AI_API_KEY=
AI_MODEL=google/gemini-2.5-flash-lite-preview-06-17

# Web App
SECRET_KEY=change-me-in-production
APP_HOST=0.0.0.0
APP_PORT=8000

# Auth (per webapp personale)
WEB_USERNAME=admin
WEB_PASSWORD=change-me

# Feature flags
ENABLE_VOICE=true
ENABLE_SEMANTIC_SEARCH=false
